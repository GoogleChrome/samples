{
  "name": "share Five",
  "icons": [
    {
      "src": "s5.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "start_url": "index.html",
  "display": "minimal-ui",
  "display_override": [ "tabbed" ],
  "share_target": {
    "action": "share-target-destination.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "text": "received_text",
      "files": [
        {
          "name": "attached_image",
          "accept": [
            ".bmp",
            ".gif",
            ".ico",
            ".jfif",
            ".jpeg",
            ".jpg",
            ".pjp",
            ".pjpeg",
            ".png",
            ".svg",
            ".svgz",
            ".tif",
            ".tiff",
            ".webp",
            ".xbm",
            "image/*"
          ]
        }
      ]
    }
  }
}
