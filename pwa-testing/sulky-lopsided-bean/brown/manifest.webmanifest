{
  "name": "Sulky Lopsided Brown Bean",
  "display": "standalone",
  "start_url": "./",
  "scope": "./",
  "theme_color": "#591313",
  "icons": [{
    "src": "./sulky-lopsided-bean-brown.svg",
    "sizes": "192x192",
    "type": "image/svg+xml"
  }],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "text": "text",
      "title": "title",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing",
    "route_to": "existing-client-retain"
  }
}