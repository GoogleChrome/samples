{
  "name": "trailblazers",
  "version": "0.1.0",
  "description": "An independent blog editor and content management tool built on top of Eleventy.",
  "type": "module",
  "scripts": {
    "build": "npx @11ty/eleventy && npx pagefind --site dist",
    "build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
    "start": "npx @11ty/eleventy --serve --quiet",
    "debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
    "format": "npx prettier --write .",
    "deploy": "npm run build && git add . && git add ./dist/ --force && git commit -a -m 'New release' && git push"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "built-in-ai-skills-md-agent-md": "^1.4.0",
    "cross-env": "^10.1.0",
    "luxon": "^3.7.2",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^12.2.0",
    "prettier": "^3.8.1",
    "prismjs": "^1.30.0",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0",
    "pagefind": "^1.5.0"
  },
  "dependencies": {
    "@zachleat/heading-anchors": "^1.0.5",
    "browser-fs-access": "^0.38.0",
    "built-in-ai-task-apis-polyfills": "^1.9.0",
    "dompurify": "^3.3.3",
    "eleventy-plugin-i18n": "^0.1.3",
    "input-switch-polyfill": "^1.11.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.0",
    "prompt-api-polyfill": "^1.15.0",
    "turndown": "^7.2.4"
  }
}
