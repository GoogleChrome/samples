---
layout: layouts/listing.njk
locale: en
title: home
eleventyNavigation:
  key: Home-en
  title: home
  order: 1
permalink: /en/index.html
numberOfLatestPostsToShow: 6
---

<div class="hero">
  <h1 class="hero-title">trAIlblazers</h1>
  <p class="hero-subtitle">Your guide to authentic adventures. Discover hidden gems, itineraries, and insider tips to see the world.</p>
  <div class="hero-bloggers">
    {% for key, author in authors %}
      <a href="/{{ locale }}/authors/{{ key }}/" class="blogger">
        <img src="{{ author.avatar }}" alt="{{ author.name }}" class="blogger-avatar">
        <span class="blogger-name">{{ author.name }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% set postsCount = collections.posts | filterByLocale(locale) | length %}
{% set latestPostsCount = postsCount | min(numberOfLatestPostsToShow) %}
<h1>{{ 'latest_posts' | plural(latestPostsCount, locale) }}</h1>

<div class="posts-section">
{% set postslist = collections.posts | filterByLocale(locale) | head(-1 * numberOfLatestPostsToShow) %}
{% set postslistCounter = postsCount %}
{% include "postslist.njk" %}

{% set morePosts = postsCount - numberOfLatestPostsToShow %}
{% if morePosts > 0 %}
<p>{{ 'more_posts' | plural(morePosts, locale) | safe }}</p>
{% endif %}
</div>

