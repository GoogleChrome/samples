{%- set destSlug = page.fileSlug -%}
{%- set destInfo = destinations[destSlug] -%}
{%- if destInfo and destInfo.cityName %}
<div class="travel-agent-widget">
  <div class="travel-agent-widget-top">
    <span class="travel-agent-widget-label">{{ 'travel_agent_widget_label' | i18n({ city: destInfo.cityName }, locale) }}</span>
    <span class="travel-agent-widget-affiliate-badge">{{ 'affiliate_link' | i18n({}, locale) }}</span>
  </div>
  <div class="travel-agent-widget-body">
    <div class="travel-agent-widget-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
    </div>
    <div class="travel-agent-widget-content">
      <p class="travel-agent-widget-tagline">{{ 'travel_agent_widget_tagline' | i18n({ city: destInfo.cityName }, locale) | safe }}</p>
      <a href="https://his-tour-search-agent.vercel.app/?destination={{ destInfo.cityName | urlencode }}"
         class="travel-agent-widget-button"
         target="_blank"
         rel="noopener"
         aria-label="Talk about {{ destInfo.cityName }} with an AI travel agent (opens in new tab)">
        <img src="/img/his-logo.jpg"
             alt="HIS Travel"
             class="travel-agent-widget-logo"
             width="400"
             height="400">
        {{ 'travel_agent_widget_button' | i18n({}, locale) }}
      </a>
    </div>
  </div>
</div>
{%- endif %}
